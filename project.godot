; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Crypt Crew"
config/description="A top-down co-op dungeon crawler for 1-4 players: the demo game of unified."
config/version="dev"
run/main_scene="res://game/menu/menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="crypt_crew"
config/features=PackedStringArray("4.7")

[audio]

buses/default_bus_layout="res://game/app/bus_layout.tres"

[autoload]

LibraryCheck="*res://game/app/library_check.tscn"
Settings="*res://game/app/settings.gd"
Sfx="*res://game/app/sfx.tscn"
Prompts="*res://game/app/prompts.tscn"
Game="*res://game/app/game.tscn"

[debug]

gdscript/warnings/directory_rules={
"res://.out": 0
}
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode.template=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://game/ui/theme.tres"

[importer_defaults]

texture={
"detect_3d/compress_to": 0
}
scene={
"_subresources": {
"materials": {
"knight": {
"use_external/enabled": true,
"use_external/path": "res://game/materials/knight.tres"
},
"barbarian": {
"use_external/enabled": true,
"use_external/path": "res://game/materials/barbarian.tres"
},
"mage": {
"use_external/enabled": true,
"use_external/path": "res://game/materials/mage.tres"
},
"rogue": {
"use_external/enabled": true,
"use_external/path": "res://game/materials/rogue.tres"
},
"skeleton": {
"use_external/enabled": true,
"use_external/path": "res://game/materials/skeleton.tres"
},
"Glow": {
"use_external/enabled": true,
"use_external/path": "res://game/materials/skeleton_glow.tres"
},
"texture": {
"use_external/enabled": true,
"use_external/path": "res://game/materials/dungeon.tres"
},
"HalloweenBits": {
"use_external/enabled": true,
"use_external/path": "res://game/materials/halloween.tres"
}
}
},
"gltf/embedded_image_handling": 0,
"meshes/ensure_tangents": false
}

