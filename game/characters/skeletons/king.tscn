[gd_scene format=3]

[ext_resource type="Script" path="res://game/characters/character_rig.gd" id="rig"]
[ext_resource type="PackedScene" path="res://assets/kaykit/skeletons/Skeleton_Warrior.glb" id="model"]
[ext_resource type="PackedScene" path="res://game/characters/rig_animations.tscn" id="animations"]
[ext_resource type="PackedScene" path="res://assets/kaykit/skeletons/Skeleton_Axe.gltf" id="right"]
[ext_resource type="PackedScene" path="res://assets/kaykit/skeletons/Skeleton_Shield_Large_A.gltf" id="left"]
[ext_resource type="PackedScene" path="res://assets/kaykit/dungeon/sword_shield_gold.gltf" id="back"]

[node name="SkeletonKing" type="Node3D"]
script = ExtResource("rig")

[node name="Model" parent="." instance=ExtResource("model")]

[node name="HandR" type="BoneAttachment3D" parent="."]
bone_name = "handslot.r"
use_external_skeleton = true
external_skeleton = NodePath("../Model/Rig_Medium/Skeleton3D")

[node name="Weapon" parent="HandR" instance=ExtResource("right")]

[node name="HandL" type="BoneAttachment3D" parent="."]
bone_name = "handslot.l"
use_external_skeleton = true
external_skeleton = NodePath("../Model/Rig_Medium/Skeleton3D")

[node name="Weapon" parent="HandL" instance=ExtResource("left")]

[node name="Back" type="BoneAttachment3D" parent="."]
bone_name = "chest"
use_external_skeleton = true
external_skeleton = NodePath("../Model/Rig_Medium/Skeleton3D")

[node name="Trophy" parent="Back" instance=ExtResource("back")]
transform = Transform3D(0.7, 0, 0, 0, 0.7, 0, 0, 0, 0.7, 0, -0.2, 0.3)

[node name="AnimationPlayer" parent="." instance=ExtResource("animations")]
