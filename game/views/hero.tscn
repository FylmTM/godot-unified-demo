[ext_resource type="PackedScene" path="res://game/characters/heroes/mage.tscn" id="mage"]
[ext_resource type="PackedScene" path="res://game/characters/heroes/rogue.tscn" id="rogue"]
[ext_resource type="PackedScene" path="res://game/fx/hero_light.tscn" id="light"]

[node name="Hero" type="Node3D"]
