[gd_scene format=3]

[ext_resource type="Script" path="res://game/ui/settings/controls_tab.gd" id="controls_tab"]
[ext_resource type="PackedScene" path="res://game/ui/settings/bind_row.tscn" id="bind_row"]
[ext_resource type="PackedScene" path="res://game/ui/widgets/setting_row.tscn" id="setting_row"]

[node name="Controls" type="ScrollContainer"]
horizontal_scroll_mode = 0
follow_focus = true
script = ExtResource("controls_tab")
bind_row_scene = ExtResource("bind_row")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="SchemeRow" type="HBoxContainer" parent="Content"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
theme_override_constants/separation = 24

[node name="Label" type="Label" parent="Content/SchemeRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Ink"
text = "Scheme"

[node name="Scheme" type="Button" parent="Content/SchemeRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(524, 0)
layout_mode = 2

[node name="Bindings" type="VBoxContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="PromptStyle" parent="Content" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"prompt_style"
label = "Pad glyphs"

[node name="MoveDeadzone" parent="Content" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"move_deadzone"
label = "Move stick dead zone"

[node name="Reset" type="Button" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 8
text = "Reset scheme"
