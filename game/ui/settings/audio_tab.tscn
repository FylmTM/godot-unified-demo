[gd_scene format=3]

[ext_resource type="PackedScene" path="res://game/ui/widgets/setting_row.tscn" id="setting_row"]

[node name="Audio" type="ScrollContainer"]
horizontal_scroll_mode = 0
vertical_scroll_mode = 4
follow_focus = true

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TabMargin"

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="MasterVolume" parent="Margin/Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"master_volume"
label = "Master volume"

[node name="MusicVolume" parent="Margin/Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"music_volume"
label = "Music volume"

[node name="EffectsVolume" parent="Margin/Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"effects_volume"
label = "Effects volume"

[node name="InterfaceVolume" parent="Margin/Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"interface_volume"
label = "Interface volume"

[node name="MuteInBackground" parent="Margin/Rows" instance=ExtResource("setting_row")]
layout_mode = 2
