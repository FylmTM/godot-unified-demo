[gd_scene format=3]

[ext_resource type="PackedScene" path="res://game/ui/widgets/setting_row.tscn" id="setting_row"]

[node name="Audio" type="ScrollContainer"]
horizontal_scroll_mode = 0
follow_focus = true

[node name="Rows" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="MasterVolume" parent="Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"master_volume"
label = "Master volume"

[node name="InterfaceVolume" parent="Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"interface_volume"
label = "Interface volume"

[node name="MuteInBackground" parent="Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"mute_in_background"
label = "Mute in the background"
