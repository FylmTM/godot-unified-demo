[gd_scene format=3]

[ext_resource type="PackedScene" path="res://game/ui/widgets/setting_row.tscn" id="setting_row"]

[node name="Gameplay" type="ScrollContainer"]
horizontal_scroll_mode = 0
vertical_scroll_mode = 4
follow_focus = true

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TabMargin"

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="PlayerName" parent="Margin/Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"player_name"
label = "Your name (the other players see it)"

[node name="ScreenShake" parent="Margin/Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"screen_shake"
label = "Screen shake"

[node name="PauseInBackground" parent="Margin/Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"pause_in_background"
label = "Pause when the window is in the background"

[node name="Hints" parent="Margin/Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"hints"
label = "Control hints on the HUD"

[node name="Flashes" parent="Margin/Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"flashes"
label = "Flashes and light pulses"

[node name="HoldActions" parent="Margin/Rows" instance=ExtResource("setting_row")]
layout_mode = 2
setting = &"hold_actions"
