[gd_scene format=3]

[ext_resource type="Script" path="res://game/play/players_screen.gd" id="players_screen"]
[ext_resource type="PackedScene" path="res://game/play/player_row.tscn" id="player_row"]
[ext_resource type="Script" path="res://game/ui/widgets/fit_to_view.gd" id="fit_to_view"]

[node name="PlayersScreen" type="Control" node_paths=PackedStringArray("first_focus")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("players_screen")
first_focus = NodePath("Center/Panel/Rows/Back")
row_scene = ExtResource("player_row")
prompts = Dictionary[String, String]({
"ui_accept": "Select",
"ui_cancel": "Back"
})

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.45)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(960, 0)
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Heading" type="Label" parent="Center/Panel/Rows"]
layout_mode = 2
theme_type_variation = &"InkHeading"
text = "Players"
horizontal_alignment = 1

[node name="List" type="VBoxContainer" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="Back" type="Button" parent="Center/Panel/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Back"

[node name="FitToView" type="Node" parent="Center"]
script = ExtResource("fit_to_view")
