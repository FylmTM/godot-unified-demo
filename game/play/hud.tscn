[gd_scene format=3]

[ext_resource type="Script" path="res://game/play/hud.gd" id="hud"]
[ext_resource type="PackedScene" path="res://game/play/hero_plate.tscn" id="hero_plate"]
[ext_resource type="PackedScene" path="res://game/ui/widgets/action_prompt.tscn" id="action_prompt"]
[ext_resource type="Script" path="res://game/play/join_cards.gd" id="join_cards"]
[ext_resource type="PackedScene" path="res://game/ui/widgets/seat_card.tscn" id="seat_card"]

[node name="Hud" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("hud")

[node name="Heroes" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 0
offset_left = 36.0
offset_top = 32.0
offset_right = 496.0
offset_bottom = 32.0
mouse_filter = 2
theme_override_constants/separation = 12

[node name="HeroPlate" parent="Heroes" instance=ExtResource("hero_plate")]
visible = false
layout_mode = 2

[node name="HeroPlate2" parent="Heroes" instance=ExtResource("hero_plate")]
visible = false
layout_mode = 2

[node name="HeroPlate3" parent="Heroes" instance=ExtResource("hero_plate")]
visible = false
layout_mode = 2

[node name="HeroPlate4" parent="Heroes" instance=ExtResource("hero_plate")]
visible = false
layout_mode = 2

[node name="Crypt" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -36.0
offset_top = 32.0
offset_right = -36.0
offset_bottom = 32.0
grow_horizontal = 0
mouse_filter = 2
theme_type_variation = &"Plate"

[node name="Stats" type="HBoxContainer" parent="Crypt"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 40

[node name="Up" type="VBoxContainer" parent="Crypt/Stats"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Skeletons" type="Label" parent="Crypt/Stats/Up"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Heading"
text = "0"
horizontal_alignment = 1

[node name="Caption" type="Label" parent="Crypt/Stats/Up"]
layout_mode = 2
theme_type_variation = &"Dim"
text = "Skeletons"
horizontal_alignment = 1

[node name="Felled" type="VBoxContainer" parent="Crypt/Stats"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Kills" type="Label" parent="Crypt/Stats/Felled"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Heading"
text = "0"
horizontal_alignment = 1

[node name="Caption" type="Label" parent="Crypt/Stats/Felled"]
layout_mode = 2
theme_type_variation = &"Dim"
text = "Felled"
horizontal_alignment = 1

[node name="Paused" type="PanelContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_top = 300.0
offset_bottom = 300.0
grow_horizontal = 2
mouse_filter = 2
theme_type_variation = &"Banner"

[node name="Text" type="Label" parent="Paused"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "Paused"
horizontal_alignment = 1

[node name="JoinHint" type="PanelContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_top = -40.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_type_variation = &"Plate"

[node name="JoinPrompt" parent="JoinHint" instance=ExtResource("action_prompt")]
unique_name_in_owner = true
layout_mode = 2
actions = Array[StringName]([&"join"])
text = "Join the game"
device = 0

[node name="JoinCards" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 6
anchor_left = 1.0
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 0.5
offset_left = -40.0
offset_right = -40.0
grow_horizontal = 0
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 24
script = ExtResource("join_cards")
card_scene = ExtResource("seat_card")
