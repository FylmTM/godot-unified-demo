[gd_scene format=3]

[ext_resource type="Script" path="res://game/play/pause_screen.gd" id="pause_screen"]
[ext_resource type="Script" path="res://game/ui/widgets/fit_to_view.gd" id="fit_to_view"]
[ext_resource type="Script" path="res://game/ui/widgets/name_label.gd" id="name_label"]

[node name="PauseScreen" type="Control" node_paths=PackedStringArray("first_focus")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("pause_screen")
first_focus = NodePath("Center/Panel/Rows/Buttons/Resume")
prompts = Dictionary[String, String]({
"ui_accept": "Select",
"ui_cancel": "Resume"
})

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.45)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(620, 0)
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Heading" type="Label" parent="Center/Panel/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(560, 0)
layout_mode = 2
theme_type_variation = &"InkHeading"
text = "Paused"
horizontal_alignment = 1
text_overrun_behavior = 3
script = ExtResource("name_label")

[node name="Status" type="Label" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"InkDim"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="VBoxContainer" parent="Center/Panel/Rows"]
custom_minimum_size = Vector2(440, 0)
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 16

[node name="Resume" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Resume"

[node name="PauseAll" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Pause for everyone"

[node name="Friends" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Invite friends"

[node name="Players" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Players"

[node name="Settings" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Settings"

[node name="Leave" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Leave to title"

[node name="Quit" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Quit to desktop"

[node name="FitToView" type="Node" parent="Center"]
script = ExtResource("fit_to_view")
