[gd_scene format=3]

[ext_resource type="Script" path="res://game/play/boon_panel.gd" id="boon_panel"]
[ext_resource type="PackedScene" path="res://game/ui/widgets/action_prompt.tscn" id="action_prompt"]

[node name="BoonPanel" type="VBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 10
script = ExtResource("boon_panel")

[node name="Title" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Heading"
horizontal_alignment = 1

[node name="Cards" type="HBoxContainer" parent="."]
