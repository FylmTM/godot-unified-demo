[gd_scene format=3]

[ext_resource type="Script" path="res://game/menu/join_code.gd" id="join_code"]
[ext_resource type="Script" path="res://game/ui/widgets/code_field.gd" id="code_field"]
[ext_resource type="Script" path="res://game/ui/widgets/fit_to_view.gd" id="fit_to_view"]

[node name="JoinCode" type="Control" node_paths=PackedStringArray("first_focus")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("join_code")
first_focus = NodePath("Center/Panel/Rows/Code")
prompts = Dictionary[String, String]({
"ui_left ui_right": "Letter",
"ui_up ui_down": "Change",
"ui_accept": "Join",
"ui_cancel": "Back"
})

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.35)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(720, 0)
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Heading" type="Label" parent="Center/Panel/Rows"]
layout_mode = 2
theme_type_variation = &"InkHeading"
text = "Join with a code"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Center/Panel/Rows"]
layout_mode = 2
theme_type_variation = &"InkDim"
text = "The code the host's game shows. Type it, or paste it."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Code" type="HBoxContainer" parent="Center/Panel/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10
script = ExtResource("code_field")

[node name="Problem" type="Label" parent="Center/Panel/Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"InkDim"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Center/Panel/Rows"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 24

[node name="Paste" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
text = "Paste"

[node name="Join" type="Button" parent="Center/Panel/Rows/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
disabled = true
text = "Join"

[node name="Back" type="Button" parent="Center/Panel/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Back"

[node name="FitToView" type="Node" parent="Center"]
script = ExtResource("fit_to_view")
