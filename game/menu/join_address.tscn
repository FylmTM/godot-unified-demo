[gd_scene format=3]

[ext_resource type="Script" path="res://game/menu/join_address.gd" id="join_address"]
[ext_resource type="Script" path="res://game/ui/widgets/fit_to_view.gd" id="fit_to_view"]

[node name="JoinAddress" type="Control" node_paths=PackedStringArray("first_focus")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("join_address")
first_focus = NodePath("Center/Panel/Rows/Address")
prompts = Dictionary[String, String]({
"ui_accept": "Select",
"ui_cancel": "Back"
})

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.35)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(720, 0)
layout_mode = 2

[node name="Rows" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Heading" type="Label" parent="Center/Panel/Rows"]
layout_mode = 2
theme_type_variation = &"InkHeading"
text = "Join an address"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Center/Panel/Rows"]
layout_mode = 2
theme_type_variation = &"InkDim"
text = "The host's address, as its game shows it (192.168.1.5:7777)."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Address" type="LineEdit" parent="Center/Panel/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
size_flags_horizontal = 4
placeholder_text = "192.168.1.5:7777"
alignment = 1
max_length = 64

[node name="Problem" type="Label" parent="Center/Panel/Rows"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"InkDim"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Join" type="Button" parent="Center/Panel/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
size_flags_horizontal = 4
disabled = true
text = "Join"

[node name="Back" type="Button" parent="Center/Panel/Rows"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Back"

[node name="FitToView" type="Node" parent="Center"]
script = ExtResource("fit_to_view")
